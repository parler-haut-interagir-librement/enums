{
  "name": "ph-il/enums",
  "type": "library",
  "description": "Zero-dependencies package to supercharge enum functionalities via helper traits.",
  "keywords": [
    "enum",
    "enumeration"
  ],
  "homepage": "https://ph-il.ca",
  "license": "MIT",
  "authors": [
    {
      "name": "Philippe Gamache",
      "email": "philippe@ph-il.ca",
      "homepage": "https://github.com/ph-il",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.1"
  },
  "require-dev": {
    "bamarni/composer-bin-plugin": "^1.8",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpdoc-parser": "^2.3",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^11.5",
    "rector/rector": "^2.2"
  },
  "autoload": {
    "psr-4": {
      "Phil\\Enums\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Phil\\Enums\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "preferred-install": {
      "*": "dist"
    },
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true,
      "phpstan/extension-installer": true
    },
    "classmap-authoritative": true,
    "sort-packages": true
  },
  "extra": {
    "bamarni-bin": {
      "bin-links": true,
      "forward-command": true
    },
    "phpstan": {
      "includes": [
        "extension.neon"
      ]
    }
  }
}